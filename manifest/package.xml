<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Meridian Building Solutions — CORE manifest
  Data model, automation, permissions, Knowledge object config.

  Retrieve with:
    sf project retrieve start -x manifest/package.xml

  Run this one FIRST. It is the least likely to fail.
  Agentforce and Experience Cloud are in separate manifests because a single
  bad member name kills the entire retrieve.
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">

    <!-- ============================================================
         CUSTOM OBJECTS
         Retrieving the object also brings its fields, validation rules,
         list views, record types, and compact layouts in source format.
         ============================================================ -->
    <types>
        <members>Site__c</members>
        <members>Service_Contract__c</members>
        <members>Equipment_Asset__c</members>
        <members>Maintenance_Visit__c</members>
        <members>Inspection_Report__c</members>
        <!-- Standard objects: pulls YOUR customizations, not the stock object -->
        <members>Account</members>
        <members>Contact</members>
        <members>Case</members>
        <members>Knowledge__kav</members>
        <name>CustomObject</name>
    </types>

    <!-- ============================================================
         CUSTOM FIELDS ON STANDARD OBJECTS
         Redundant with the above in most orgs, but explicit here because
         Knowledge__kav field retrieval is inconsistent. Belt and braces.
         ============================================================ -->
    <types>
        <members>Account.External_ERP_Customer_Id__c</members>
        <members>Knowledge__kav.Article_Body__c</members>
        <members>Knowledge__kav.Category__c</members>
        <name>CustomField</name>
    </types>

    <!-- ============================================================
         FLOWS
         5 Project 1 action flows + the Data Cloud-triggered write-back
         + the Omni-Channel routing flow.

         If a name is wrong the whole retrieve fails. If that happens,
         swap this block for a single <members>*</members>.
         ============================================================ -->
    <types>
        <members>Get_Contract_Coverage</members>
        <members>Get_Next_Visit</members>
        <members>Get_Last_Inspection</members>
        <members>Get_Equipment_Health</members>
        <members>Submit_Service_Request</members>
        <members>Sync_Health_Score_To_CRM</members>
        <members>Route_To_Meridian_Assistant</members>
        <name>Flow</name>
    </types>

    <!-- ============================================================
         PERMISSIONS
         Profile retrieval is notoriously partial — you get the profile
         only for objects/fields also present in this manifest. That is
         actually fine here, since the manifest covers the relevant ones.
         ============================================================ -->
    <types>
        <members>*</members>
        <name>PermissionSet</name>
    </types>

    <types>
        <members>Meridian Portal Customer</members>
        <name>Profile</name>
    </types>

    <!-- ============================================================
         LAYOUTS
         Needed to capture the Knowledge layout carrying
         "Visible to Customer" (IsVisibleInCsp) — the field that made
         articles portal-visible. That is a real design artifact.
         ============================================================ -->
    <types>
        <members>*</members>
        <name>Layout</name>
    </types>

    <types>
        <members>*</members>
        <name>CustomTab</name>
    </types>

    <!-- ============================================================
         STATIC RESOURCES
         Lives here rather than in the Experience manifest because it is
         an org-wide type, not a site-scoped one.

         Where the Meridian logo landed depends on how you uploaded it:
           - via Experience Builder theme  → ContentAsset (Experience manifest)
           - via Setup > Static Resources  → StaticResource (here)
           - via Setup > Company Information → NOT retrievable at all;
             it is an org setting, so commit the source SVG to docs/assets/
         Both types are wildcarded, so you do not need to know in advance.
         ============================================================ -->
    <types>
        <members>*</members>
        <name>StaticResource</name>
    </types>

    <!-- ============================================================
         ROLES
         The admin role (set to CEO) was a hard prerequisite for enabling
         portal users. Worth capturing so the README claim is verifiable.
         ============================================================ -->
    <types>
        <members>*</members>
        <name>Role</name>
    </types>

    <version>67.0</version>
</Package>
