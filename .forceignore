# List files or directories below to ignore them when running force:source:push, force:source:pull, and force:source:status
# More information: https://developer.salesforce.com/docs/atlas.en-us.sfdx_dev.meta/sfdx_dev/sfdx_dev_exclude_source.htm
#

package.xml

# LWC configuration files
**/jsconfig.json
**/.eslintrc.json

# LWC Jest
**/__tests__/**

node_modules/

# ─────────────────────────────────────────────────────────────────────────────
# PORTFOLIO CURATION — added 2026-09-03
#
# This repo is a portfolio artifact, not an org backup. It tracks what was
# BUILT here. A wildcard retrieve returns thousands of files Salesforce ships
# with every Developer Edition org, and those drown the work.
#
# Everything below was retrieved once, reviewed, and judged stock. Removing it
# from the repo is not enough: the next wide retrieve writes it straight back.
# This file is what makes the decision stick.
# ─────────────────────────────────────────────────────────────────────────────

# Page layouts. 178 of 184 were stock. Keep only the objects this build created,
# plus Knowledge, whose layout carries "Visible to Customer" (IsVisibleInCsp).
force-app/main/default/layouts/**
!force-app/main/default/layouts/Site__c-*
!force-app/main/default/layouts/Service_Contract__c-*
!force-app/main/default/layouts/Equipment_Asset__c-*
!force-app/main/default/layouts/Maintenance_Visit__c-*
!force-app/main/default/layouts/Inspection_Report__c-*
!force-app/main/default/layouts/Knowledge__kav-*

# Roles. All stock DE sample roles except CEO, which the docs cite as a
# prerequisite for enabling portal users.
force-app/main/default/roles/**
!force-app/main/default/roles/CEO.role-meta.xml

# Static resources: Salesforce's SiteSamples images (clock.png, warning.png...).
force-app/main/default/staticresources/**

# Permission sets installed by Salesforce or generated by feature setup.
# Keep only the two this build authored, plus Agentforce_Setup.
force-app/main/default/permissionsets/sfdcInternalInt__*
force-app/main/default/permissionsets/sfdc_aiplanner_service_permset.*
force-app/main/default/permissionsets/NextGen_*
force-app/main/default/permissionsets/Service_Agent_Test*
force-app/main/default/permissionsets/test*_Permissions.*
force-app/main/default/permissionsets/Experience_Profile_Manager.*

# Stock agents and flows that ship with the org.
force-app/main/default/bots/Copilot_for_Salesforce/**
force-app/main/default/genAiPlannerBundles/EmployeeCopilotPlanner/**
force-app/main/default/flows/sfdc_default_*
force-app/main/default/flowDefinitions/sfdc_default_*

# Scratch artifacts from an abandoned embedded-messaging test deployment.
force-app/main/default/genAiPromptTemplates/test_retriever.*
force-app/main/default/messagingChannels/test.messagingChannel-meta.xml
force-app/main/default/EmbeddedServiceConfig/test.EmbeddedServiceConfig-meta.xml
**/ESW_test_*
**/cbESW_test_*
**/Default_ESW_test_*
**/*ESWUU005ftestUU005f*

# Profiles. A Profile retrieve is object-scoped: asking for one profile returns
# every profile holding permissions on the objects in the package, which here is
# all 40+ stock ones. Listed individually because ".../profiles/** plus a
# negation" does NOT work on retrieve in this CLI version: the files are written
# regardless. Verified by trying it. Only explicit per-file entries hold.
