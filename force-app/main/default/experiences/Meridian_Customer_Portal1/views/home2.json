          "componentAttributes": {
            "richTextValue": "<div style=\"background: linear-gradient(135deg, #1b3a5c 0%, #2d5f8a 100%);\n            padding: 48px 40px; border-radius: 8px; color: #ffffff;\">\n  <p style=\"margin:0 0 8px; font-size:13px; letter-spacing:1.5px;\n            text-transform:uppercase; opacity:0.75;\">\n    Meridian Building Solutions\n  </p>\n  <h1 style=\"margin:0 0 14px; font-size:34px; font-weight:600; color:#ffffff;\">\n    Your Service Portal\n  </h1>\n  <p style=\"margin:0; font-size:17px; line-height:1.5; max-width:640px; opacity:0.92;\">\n    Ask the Meridian assistant about your service contract, upcoming maintenance\n    visits, inspection reports, and equipment health — or submit a service request\n    anytime.\n  </p>\n</div>"
          },
          "componentName": "forceCommunity:htmlBlock",
          "id": "3c02ed42-19f1-4d03-9488-90cf135d4485",
          "renderPriority": "NEUTRAL",
          "renditionMap": {},
