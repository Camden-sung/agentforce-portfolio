        },
        {
          "componentAttributes": {
            "richTextValue": "<div style=\"display:flex; flex-wrap:wrap; gap:16px; margin-top:24px;\">\n\n  <div style=\"flex:1 1 220px; background:#ffffff; border:1px solid #dfe3e8;\n              border-radius:8px; padding:22px;\">\n    <h3 style=\"margin:0 0 6px; font-size:17px; color:#1b3a5c;\">Your Contract</h3>\n    <p style=\"margin:0; font-size:14px; color:#5a6570; line-height:1.45;\">\n      Coverage level, included maintenance visits, and emergency response times.\n    </p>\n  </div>\n\n  <div style=\"flex:1 1 220px; background:#ffffff; border:1px solid #dfe3e8;\n              border-radius:8px; padding:22px;\">\n    <h3 style=\"margin:0 0 6px; font-size:17px; color:#1b3a5c;\">Upcoming Visits</h3>\n    <p style=\"margin:0; font-size:14px; color:#5a6570; line-height:1.45;\">\n      See when your next scheduled service visit is and who's assigned to it.\n    </p>\n  </div>\n\n  <div style=\"flex:1 1 220px; background:#ffffff; border:1px solid #dfe3e8;\n              border-radius:8px; padding:22px;\">\n    <h3 style=\"margin:0 0 6px; font-size:17px; color:#1b3a5c;\">Inspection Reports</h3>\n    <p style=\"margin:0; font-size:14px; color:#5a6570; line-height:1.45;\">\n      Review recent inspection findings and recommended actions.\n    </p>\n  </div>\n\n  <div style=\"flex:1 1 220px; background:#ffffff; border:1px solid #dfe3e8;\n              border-radius:8px; padding:22px;\">\n    <h3 style=\"margin:0 0 6px; font-size:17px; color:#1b3a5c;\">Equipment Health</h3>\n    <p style=\"margin:0; font-size:14px; color:#5a6570; line-height:1.45;\">\n      Check how your equipment is running, based on live monitoring data.\n    </p>\n  </div>\n\n</div>"
          },
