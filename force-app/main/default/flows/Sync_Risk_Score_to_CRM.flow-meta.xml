<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <formulas>
        <name>frm_ARPoints</name>
        <dataType>Number</dataType>
        <expression>ROUND({!$Record.ARRiskPoints__c}, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>frm_CasePoints</name>
        <dataType>Number</dataType>
        <expression>ROUND({!$Record.CaseRiskPoints__c}, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>frm_OpenCases</name>
        <dataType>Number</dataType>
        <expression>ROUND({!$Record.OpenCaseCount__c}, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>frm_PortalEvents</name>
        <dataType>Number</dataType>
        <expression>ROUND({!$Record.PortalEventCount__c}, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>frm_PortalPoints</name>
        <dataType>Number</dataType>
        <expression>ROUND({!$Record.PortalRiskPoints__c}, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>frm_RiskScore</name>
        <dataType>Number</dataType>
        <expression>ROUND({!$Record.RiskScore__c}, 0)</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Sync Risk Score to CRM {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Sync Risk Score to CRM</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Account</name>
        <label>Update Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>External_ERP_Customer_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountExternalId__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>AR_Outstanding_Scored__c</field>
            <value>
                <elementReference>$Record.ARTotalOutstanding__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Account_Risk_Score__c</field>
            <value>
                <elementReference>frm_RiskScore</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Open_Case_Count_scored__c</field>
            <value>
                <elementReference>frm_OpenCases</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Portal_Event_Count_Scored__c</field>
            <value>
                <elementReference>frm_PortalEvents</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Risk_AR_Points__c</field>
            <value>
                <elementReference>frm_ARPoints</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Risk_Case_Points__c</field>
            <value>
                <elementReference>frm_CasePoints</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Risk_Portal_Points__c</field>
            <value>
                <elementReference>frm_PortalPoints</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Risk_Score_Last_Synced__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RiskScore__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <object>Account_Risk_Score__cio</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>DataCloudDataChange</triggerType>
    </start>
    <status>Active</status>
</Flow>
