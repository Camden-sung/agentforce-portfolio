        </rules>
    </decisions>
    <decisions>
        <name>Score_Found</name>
        <label>Score Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Health_Summary_Not_found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Score_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_CRM_Equipment_Asset.Equipment_Health_Score__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_5</targetReference>
            </connector>
            <label>Yes, Score Found</label>
        </rules>
    </decisions>
    <description>Run in system context.</description>
    <environments>Default</environments>
    <formulas>
        <name>frm_AccountId15</name>
        <dataType>String</dataType>
        <expression>LEFT({!var_AccountId}, 15)</expression>
    </formulas>
    <formulas>
        <name>frm_Band</name>
        <dataType>String</dataType>
        <expression>IF({!Get_CRM_Equipment_Asset.Equipment_Health_Score__c} &gt;= 90, &quot;operating normally&quot;, IF({!Get_CRM_Equipment_Asset.Equipment_Health_Score__c} &gt;= 70, &quot;showing some wear worth keeping an eye on&quot;, &quot;showing signs that warrant a closer look, and may need service&quot;))</expression>
    </formulas>
    <interviewLabel>Get Equipment Health {!$Flow.CurrentDateTime}</interviewLabel>
