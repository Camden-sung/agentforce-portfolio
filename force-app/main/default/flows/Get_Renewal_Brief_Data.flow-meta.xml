            </connector>
            <label>Emergency Completed</label>
        </rules>
        <rules>
            <name>Other_Completed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >Loop_Visits.Visit_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
