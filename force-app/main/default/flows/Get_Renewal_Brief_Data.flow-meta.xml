    <formulas>
        <name>frm_ARAged</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK({!Get_AR_Aging.erp_customer_id__c}), 0,
    {!Get_AR_Aging.days_60_90__c} + {!Get_AR_Aging.days_90_120__c} + {!Get_AR_Aging.days_120_plus__c} )</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>frm_ARAgeDays</name>
        <dataType>String</dataType>
        <expression
    >IF( ISBLANK({!Get_AR_Aging.snapshot_date__c}), &quot;unknown&quot;,
    TEXT({!$Flow.CurrentDate} - {!Get_AR_Aging.snapshot_date__c}) )</expression>
    </formulas>
    <formulas>
        <name>frm_ARAsOf</name>
        <dataType>String</dataType>
        <expression
    >IF( ISBLANK({!Get_AR_Aging.snapshot_date__c}), &quot;unknown&quot;,
    TEXT({!Get_AR_Aging.snapshot_date__c}) )</expression>
    </formulas>
    <formulas>
        <name>frm_ARDetail</name>
        <dataType>String</dataType>
        <expression
    >IF( ISBLANK({!Get_AR_Aging.erp_customer_id__c}), &quot;-&quot;,
    &quot;total $&quot; &amp; TEXT(ROUND({!Get_AR_Aging.total_outstanding__c}, 0)) &amp;
    &quot; | aged 60+ $&quot; &amp; TEXT(ROUND({!frm_ARAged}, 0)) &amp;
    &quot; | 120+ $&quot; &amp; TEXT(ROUND({!Get_AR_Aging.days_120_plus__c}, 0)) )</expression>
    </formulas>
    <formulas>
        <name>frm_ARStatus</name>
        <dataType>String</dataType>
        <expression
    >IF( ISBLANK({!Get_AR_Aging.erp_customer_id__c}), &quot;no AR record on file&quot;,
IF( {!Get_AR_Aging.credit_status__c} = &quot;On Hold&quot;, &quot;CREDIT HOLD&quot;,
IF( {!frm_ARAged} &gt; 0, &quot;aged balances present&quot;, &quot;current&quot; )))</expression>
    </formulas>
    <formulas>
        <name>frm_AvgSat</name>
        <dataType>String</dataType>
        <expression
    >IF( {!var_SatCount} = 0, &quot;no rated visits on record&quot;,
    TEXT( ROUND({!var_SatSum} / {!var_SatCount}, 1) ) &amp; &quot; / 5 (&quot; &amp; TEXT({!var_SatCount}) &amp; &quot; rated)&quot; )</expression>
    </formulas>
    <formulas>
        <name>frm_CaseLine</name>
        <dataType>String</dataType>
        <expression
    >&quot;  - [&quot; &amp; TEXT({!Loop_Cases.Priority}) &amp; &quot;/&quot; &amp; TEXT({!Loop_Cases.Status}) &amp; &quot;] &quot; &amp; {!Loop_Cases.Subject} &amp; &quot; (&quot; &amp; TEXT({!Loop_Cases.Type}) &amp; &quot;)&quot; &amp; BR()</expression>
    </formulas>
    <formulas>
        <name>frm_CaseSummary</name>
        <dataType>String</dataType>
        <expression>IF( {!var_CaseTotal} = 0, &quot;none open&quot;,
    TEXT({!var_CaseTotal}) &amp; &quot; open (&quot; &amp; TEXT({!var_CaseHigh}) &amp; &quot; high, &quot; &amp;
    TEXT({!var_CaseMed}) &amp; &quot; medium, &quot; &amp; TEXT({!var_CaseLow}) &amp; &quot; low)&quot; )</expression>
    </formulas>
    <formulas>
        <name>frm_ContactLine</name>
        <dataType>String</dataType>
        <expression
    >&quot;  - &quot; &amp; {!Loop_Contacts.FirstName} &amp; &quot; &quot; &amp; {!Loop_Contacts.LastName} &amp;
&quot;, &quot; &amp; {!Loop_Contacts.Title} &amp; BR()</expression>
    </formulas>
    <formulas>
        <name>frm_ContactSummary</name>
        <dataType>String</dataType>
        <expression
    >IF( LEN({!var_ContactList}) = 0, &quot;no contacts on record for this account&quot;,
    {!var_ContactList} )</expression>
    </formulas>
    <formulas>
        <name>frm_EndDate</name>
        <dataType>String</dataType>
        <expression>TEXT({!var_MatchedContract.End_Date__c})</expression>
    </formulas>
    <formulas>
        <name>frm_IsMatch</name>
        <dataType>Boolean</dataType>
        <expression
    >CONTAINS(UPPER({!Loop_Book.Account__r.Name}), UPPER({!AccountSearchTerm}))</expression>
    </formulas>
    <formulas>
        <name>frm_MatchLine</name>
        <dataType>String</dataType>
        <expression
    >{!Loop_Book.Account__r.Name} &amp; &quot; (&quot; &amp; {!Loop_Book.Name} &amp; &quot;); &quot;</expression>
    </formulas>
    <formulas>
        <name>frm_NoticeStatus</name>
        <dataType>String</dataType>
        <expression
    >IF( ISBLANK({!var_MatchedContract.Renewal_Notice_Date__c}), &quot;no notice date on record&quot;,
IF( {!var_MatchedContract.Renewal_Notice_Date__c} &lt;= {!$Flow.CurrentDate},
    &quot;OPEN since &quot; &amp; TEXT({!var_MatchedContract.Renewal_Notice_Date__c}),
    &quot;opens &quot; &amp; TEXT({!var_MatchedContract.Renewal_Notice_Date__c}) ))</expression>
    </formulas>
    <formulas>
        <name>frm_PMExpected</name>
        <dataType>Number</dataType>
        <expression
    >FLOOR( {!var_MatchedContract.Number_of_PM_Visits_Per_Year__c} *
       ( ({!$Flow.CurrentDate} - {!var_MatchedContract.Start_Date__c}) / 365 ) )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>frm_PMOutstanding</name>
        <dataType>Number</dataType>
        <expression
    >MAX( 0, {!frm_PMExpected} - {!var_PMDelivered} )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>frm_PMStatus</name>
        <dataType>String</dataType>
        <expression>IF( {!frm_PMExpected} = 0, &quot;TOO EARLY TO ASSESS&quot;,
IF( {!var_PMDelivered} &gt;= ({!frm_PMExpected} * 2), &quot;OVER-DELIVERING&quot;,
IF( {!var_PMDelivered} &gt;= {!frm_PMExpected}, &quot;ON TRACK&quot;,
IF( {!var_PMDelivered} = 0, &quot;NONE DELIVERED&quot;,
IF( {!var_PMDelivered} &lt; ({!frm_PMExpected} / 2), &quot;SIGNIFICANTLY BEHIND&quot;,
    &quot;BEHIND&quot; )))))</expression>
    </formulas>
    <formulas>
        <name>frm_RiskAgeDays</name>
        <dataType>String</dataType>
        <expression
    >IF( ISBLANK({!var_MatchedContract.Account__r.Risk_Score_Last_Synced__c}), &quot;unknown&quot;,
    TEXT({!$Flow.CurrentDate} - DATEVALUE({!var_MatchedContract.Account__r.Risk_Score_Last_Synced__c})) )</expression>
    </formulas>
    <formulas>
        <name>frm_RiskComponents</name>
        <dataType>String</dataType>
        <expression
    >IF( ISBLANK({!var_MatchedContract.Account__r.Account_Risk_Score__c}),
    &quot;not available&quot;,
IF( {!var_MatchedContract.Account__r.Account_Risk_Score__c} = 0,
    &quot;all risk components are zero&quot;,
    &quot;portal &quot; &amp; TEXT({!var_MatchedContract.Account__r.Risk_Portal_Points__c}) &amp;
    &quot; | cases &quot; &amp; TEXT({!var_MatchedContract.Account__r.Risk_Case_Points__c}) &amp;
    &quot; | AR &quot; &amp; TEXT({!var_MatchedContract.Account__r.Risk_AR_Points__c}) ))</expression>
    </formulas>
    <formulas>
        <name>frm_RiskLine</name>
        <dataType>String</dataType>
        <expression
    >IF( ISBLANK({!var_MatchedContract.Account__r.Account_Risk_Score__c}),
    &quot;not available&quot;,
    TEXT({!var_MatchedContract.Account__r.Account_Risk_Score__c}) &amp; &quot;/100&quot; )</expression>
    </formulas>
    <formulas>
        <name>frm_RiskSynced</name>
        <dataType>String</dataType>
        <expression
    >IF( ISBLANK({!var_MatchedContract.Account__r.Risk_Score_Last_Synced__c}),
    &quot;never synced&quot;,
    TEXT(DATEVALUE({!var_MatchedContract.Account__r.Risk_Score_Last_Synced__c})) )</expression>
    </formulas>
    <formulas>
        <name>frm_SatCounted</name>
        <dataType>Number</dataType>
        <expression
    >IF( ISPICKVAL({!Loop_Visits.Customer_Satisfaction_Rating__c}, &quot;&quot;), 0, 1 )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>frm_SatValue</name>
        <dataType>Number</dataType>
        <expression
    >IF( ISPICKVAL({!Loop_Visits.Customer_Satisfaction_Rating__c}, &quot;&quot;), 0,
    VALUE(LEFT(TEXT({!Loop_Visits.Customer_Satisfaction_Rating__c}), 1)) )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>frm_StartDate</name>
        <dataType>String</dataType>
        <expression>TEXT({!var_MatchedContract.Start_Date__c})</expression>
    </formulas>
    <formulas>
        <name>frm_StatedVsComputed</name>
        <dataType>String</dataType>
        <expression
    >&quot;AE&apos;s stored likelihood of RENEWING: &quot; &amp; TEXT({!var_MatchedContract.Renewal_Probability__c}) &amp;
&quot; (higher = more likely to renew). Computed RISK: &quot; &amp; {!frm_RiskLine} &amp;
&quot; (higher = more risk). These scales run in OPPOSITE directions.&quot;</expression>
    </formulas>
