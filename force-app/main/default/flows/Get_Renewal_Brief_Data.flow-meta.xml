        <defaultConnector>
            <targetReference>Loop_Visits</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Counted</defaultConnectorLabel>
        <rules>
            <name>PM_Completed</name>
            <conditionLogic>(1 OR 2) AND 3 AND 4</conditionLogic>
            <conditions>
                <leftValueReference
        >Loop_Visits.Visit_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Preventive Maintenance</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >Loop_Visits.Visit_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Quarterly Tune-up</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >Loop_Visits.Visit_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >Loop_Visits.Scheduled_Start__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference
          >var_MatchedContract.Start_Date__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Count_PM</targetReference>
            </connector>
            <label>PM Completed</label>
        </rules>
        <rules>
            <name>Emergency_Completed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >Loop_Visits.Visit_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Emergency Repair</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >Loop_Visits.Visit_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
