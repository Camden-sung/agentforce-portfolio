            </connector>
            <label>Other Completed</label>
        </rules>
        <rules>
            <name>Overdue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >Loop_Visits.Visit_Status__c</leftValueReference>
                <operator>EqualTo</operator>
