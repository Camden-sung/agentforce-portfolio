        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>AgentContext</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ContactIdInput</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AgentContext_Get_Contact</targetReference>
            </connector>
            <label>AgentContext</label>
        </rules>
        <rules>
            <name>Internal_User</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_User.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Contact</targetReference>
            </connector>
            <label>Internal User</label>
        </rules>
    </decisions>
    <decisions>
        <name>Inspection_Found</name>
        <label>Inspection Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference
      >Assign_InspectionSummary_Inspection_Not_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Inspection_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >Get_Inspection_Report.Inspection_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Equipment_Asset</targetReference>
            </connector>
            <label>Yes, Inspection Found</label>
        </rules>
    </decisions>
    <description>run in system context</description>
    <environments>Default</environments>
    <formulas>
