<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Append_Line</name>
        <label>Append_Line</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_Output</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>txt_ContractLine</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Contracts</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_No_Renewals</name>
        <label>Set_No_Renewals</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_Output</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue
        >You have no contracts pending renewal.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Any_Renewals</name>
        <label>Any_Renewals</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_No_Renewals</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Has_Renewals</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_My_Pending_Renewals</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Contracts</targetReference>
            </connector>
            <label>Has Renewals</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>frm_NoticeStatus</name>
        <dataType>String</dataType>
        <expression>IF( {!Loop_Contracts.Renewal_Notice_Date__c} &lt;= TODAY(),
    &quot;OPEN since &quot; &amp; TEXT({!Loop_Contracts.Renewal_Notice_Date__c}),
    &quot;opens &quot; &amp; TEXT({!Loop_Contracts.Renewal_Notice_Date__c}) )</expression>
    </formulas>
    <formulas>
        <name>frm_TopDriver</name>
        <dataType>String</dataType>
        <expression
    >IF( ISBLANK({!Loop_Contracts.Account__r.Account_Risk_Score__c}),
  &quot;risk score not available&quot;,
IF( {!Loop_Contracts.Account__r.Account_Risk_Score__c} = 0,
  &quot;no risk signal from portal, cases, or AR (service delivery not scored)&quot;,
IF( {!Loop_Contracts.Account__r.Risk_AR_Points__c} &gt;= {!Loop_Contracts.Account__r.Risk_Case_Points__c}
    &amp;&amp; {!Loop_Contracts.Account__r.Risk_AR_Points__c} &gt;= {!Loop_Contracts.Account__r.Risk_Portal_Points__c},
  &quot;driven by AR / payment behavior&quot;,
IF( {!Loop_Contracts.Account__r.Risk_Case_Points__c} &gt;= {!Loop_Contracts.Account__r.Risk_Portal_Points__c},
  &quot;driven by open cases&quot;,
  &quot;driven by low portal engagement&quot; ))))</expression>
    </formulas>
    <formulas>
        <name>frm_ACVDisplay</name>
        <dataType>String</dataType>
        <expression
    >&quot;$&quot; &amp; TEXT(ROUND({!Loop_Contracts.Annual_Contract_Value__c}, 0))</expression>
    </formulas>
    <interviewLabel>Get My Renewals {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Get My Renewals</label>
    <loops>
        <name>Loop_Contracts</name>
        <label>Loop_Contracts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_My_Pending_Renewals</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Append_Line</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_My_Pending_Renewals</name>
        <label>Get_My_Pending_Renewals</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound
    >false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Any_Renewals</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Contract_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending Renewal</stringValue>
            </value>
        </filters>
        <filters>
            <field>Account_Executive__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Service_Contract__c</object>
        <sortField>End_Date__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_My_Pending_Renewals</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>txt_ContractLine</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!Loop_Contracts.Name} — {!Loop_Contracts.Account__r.Name}
{!Loop_Contracts.Coverage_Level__c} | ACV {!frm_ACVDisplay} | margin {!Loop_Contracts.Contract_Margin__c}%
Ends {!Loop_Contracts.End_Date__c} ({!Loop_Contracts.Days_Until_Expiration__c} days) | Notice window {!frm_NoticeStatus}
Risk {!Loop_Contracts.Account__r.Account_Risk_Score__c}/100 — {!frm_TopDriver}
</text>
    </textTemplates>
    <variables>
        <name>Unused_Platform_Input</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>var_Output</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
